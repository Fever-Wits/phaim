[Unit]
Description=shunt nonsecure daemon (TCP + token remote hands)
After=network-online.target
Wants=network-online.target

[Service]
# ⚠ PRODUCTION: run the daemon as a NON-root user — damage on a breach = only that user's privileges.
# Uncomment and configure (the user must exist on the server):
#User=shunt
#Group=shunt
EnvironmentFile=/etc/shunt/daemon.env
ExecStart=/usr/bin/python3 /opt/shunt/daemon.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
